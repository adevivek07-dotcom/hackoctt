# ShetiRakshak Backend - Production Environment Variables Template
# Strict Rule: NEVER commit real production API keys or service role secrets to version control.
# Configure these securely in the Render Dashboard (Environment tab).

NODE_ENV=production
PORT=10000
CORS_ORIGIN=https://shetirakshak.vercel.app

# External Weather Provider (WeatherAPI.com - Paid Tier for Production)
WEATHER_API_KEY=your_production_weatherapi_key

# Bounded AI Assistance (Google Gemini 2.5 Flash Production Key)
GEMINI_API_KEY=your_production_gemini_api_key

# Supabase Production Database & Storage (Isolated from Development)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

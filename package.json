{
  "name": "shetirakshak-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "clean:ports": "node backend/src/scripts/freePort.js 5000 && node backend/src/scripts/freePort.js 5173",
    "clean:backend": "node backend/src/scripts/freePort.js 5000",
    "build:frontend": "npm --prefix frontend run build",
    "verify:supabase": "node --env-file=backend/.env supabase/verify_connection.js",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
